PORT=3000
CORS_ORIGIN=http://localhost:5173
# URL del frontend a la que vuelve Mercado Pago (sandbox)
FRONTEND_URL=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD= #Ingrese su contraseña de postgres
PGDATABASE= Pizzeria

# Clave secreta para firmar los tokens: larga y aleatoria.
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET= 
# Duración del token (ej: 1h, 15m, 1m para probar el vencimiento en clase)
JWT_EXPIRES_IN=6h

MERCADOPAGO_ACCESS_TOKEN=TEST-tu-token-super-largo
